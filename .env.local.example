# Copy this file to .env.local and fill in values.

# --- OpenAI: the AI Judge (server-side /api/judge, never sent to the browser) ---
OPENAI_API_KEY=sk-...

# --- fal.ai: SDXL Lightning verdict images (server-only). Optional —
#     without it the result screen just uses a dark background. ---
FAL_KEY=YOUR-FAL-KEY

# --- Supabase: OPTIONAL. Saves max level reached + a log of plans/outcomes.
#     The game plays fully without these; persistence is just skipped.
#     Dashboard -> Project Settings -> API ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
