# Copy this file to .env.local and fill in values from your Supabase project
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Service-role key — server-only. Used by /api/trust-gate to enforce bans.
# DO NOT prefix with NEXT_PUBLIC_; it must never leak to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# OpenAI — used only by server-side /api/generate-node, never sent to the browser
OPENAI_API_KEY=sk-...

# fal.ai — SDXL Lightning image generation (server-only)
FAL_KEY=YOUR-FAL-KEY

# ElevenLabs — narrative TTS (server-only)
ELEVENLABS_API_KEY=YOUR-ELEVENLABS-KEY
# Optional: override the default Rachel voice
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
